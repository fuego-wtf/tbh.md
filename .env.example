# tbh.md - Environment Variables
# Copy this file to .env and fill in your values

# Backyard catalog API endpoint (optional — static fallback used if unset)
VITE_TBH_CATALOG_URL=

# PostHog (US cloud project 211565)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# CLI-only environment (used when running the tbh CLI)
TBH_CATALOG_URL=
TBH_ARTIFACT_BASE_URL=https://tbh.md
TBH_INSTALL_TARGET=default
TBH_INSTALL_API_BASE=
TBH_INSTALL_PATH=/api/tbh/install
TBH_INSTALL_DIR=
